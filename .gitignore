# generated workbooks embed overlay values when a local overlay is configured
output/
__pycache__/
*.pyc
.venv/
*.egg-info/

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/

# Override logs from hooks (regenerated locally)
docs/analysis/*.log

# Shape-only reproducer artifacts (see docs/human/debugging-your-real-file.md)
tmp/

# diff/ holds user-supplied xlsx pairs for scripts/xlsx_structural_diff.py;
# contents are potentially confidential — track the folder, ignore contents.
diff/*
!diff/.gitkeep
