%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#4A90D9', 'primaryTextColor': '#fff', 'primaryBorderColor': '#2C5F8A', 'lineColor': '#555', 'secondaryColor': '#F5A623', 'tertiaryColor': '#7ED321'}}}%%

graph TD
    subgraph inputs["🔵 Input"]
        TEAM["<b>Team</b><br/><i>Orange tab</i><br/>Roster + Max FTE<br/>WP share seeds"]
    end

    subgraph planning["🟣 Planning"]
        CAPACITY["<b>Capacity</b><br/><i>Purple tab</i><br/>Per-person monthly<br/>FTE allocation"]
    end

    subgraph core["⚙️ Core"]
        PLAN["<b>Plan</b><br/><i>Default tab</i><br/>Project config<br/>WP ceilings<br/>Planned FTE grid"]
    end

    subgraph tracking["📊 Execution & Tracking"]
        ACTUALS["<b>Actuals</b><br/><i>Blue tab</i><br/>EUR per WP per month<br/><i>(from accountant)</i>"]
        SUMMARY["<b>Summary</b><br/><i>Green tab</i><br/>Annual FTE/EUR<br/>Budget overview<br/>Ceiling tracking"]
    end

    subgraph docs["🔴 Documentation"]
        META["<b>_META</b><br/><i>Red tab</i><br/>AI-agent docs"]
    end

    %% Data flows
    TEAM -->|"person names,<br/>max FTE"| CAPACITY
    PLAN -->|"WP names"| CAPACITY
    CAPACITY -->|"SUM formulas:<br/>monthly FTE per WP"| PLAN
    PLAN -->|"WP structure,<br/>start/end, ceilings"| ACTUALS
    PLAN -->|"Plan FTE, Plan EUR,<br/>partner_ceiling"| SUMMARY
    ACTUALS -->|"Actual EUR<br/>per WP per year"| SUMMARY

    %% Styling
    classDef inputSheet fill:#4A90D9,stroke:#2C5F8A,color:#fff,stroke-width:2px
    classDef planningSheet fill:#9B59B6,stroke:#7D3C98,color:#fff,stroke-width:2px
    classDef coreSheet fill:#95A5A6,stroke:#7F8C8D,color:#fff,stroke-width:2px
    classDef outputSheet fill:#7ED321,stroke:#5CA118,color:#fff,stroke-width:2px
    classDef docsSheet fill:#E74C3C,stroke:#C0392B,color:#fff,stroke-width:2px

    class TEAM,ACTUALS inputSheet
    class CAPACITY planningSheet
    class PLAN coreSheet
    class SUMMARY outputSheet
    class META docsSheet
